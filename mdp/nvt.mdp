title       = NVT equilibration
define      = -DPOSRES
integrator  = md
nsteps      = 25000      ; 25000 * 2fs = 50 ps
dt          = 0.002
nstxout     = 500
nstvout     = 500
nstenergy   = 500
nstlog      = 500
continuation    = no
constraint_algorithm = lincs
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4
cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 10
rcoulomb        = 1.0
rvdw            = 1.0
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.12
tcoupl          = V-rescale
tc-grps         = non-Water Water
tau_t           = 0.1     0.1
ref_t           = 300     300
pcoupl          = no
pbc             = xyz
DispCorr        = EnerPres
gen_vel         = yes
gen_temp        = 300
gen_seed        = -1
